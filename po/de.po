#: src/main.rs:164
msgid ""
"No models found beside the application; PDFs and images will not convert"
msgstr ""
"Keine Modelle neben der Anwendung gefunden; PDFs und Bilder werden nicht "
"umgewandelt"

#: src/main.rs:175
msgid "Built without ONNX Runtime: PDFs and images will not convert"
msgstr "Ohne ONNX Runtime gebaut: PDFs und Bilder werden nicht umgewandelt"

#: src/main.rs:202
msgid "Duckling could not start"
msgstr "Duckling konnte nicht starten"

#: src/main.rs:204
msgid ""
"The window could not be opened.\n"
"\n"
"{reason}\n"
"\n"
"This is usually a graphics driver the window system could not use. Duckling "
"needs no particular graphics card, but it does need one the system can talk "
"to."
msgstr ""
"Das Fenster konnte nicht geöffnet werden.\n"
"\n"
"{reason}\n"
"\n"
"Meist ist das ein Grafiktreiber, mit dem das Fenstersystem nichts anfangen "
"konnte. Duckling braucht keine bestimmte Grafikkarte, aber eine, mit der das "
"System sprechen kann."

#: src/main.rs:268
msgid ""
"{format} is offered only when every file is {input}; the format is back to "
"{default}"
msgstr ""
"{format} wird nur angeboten, wenn alle Dateien {input} sind; das Format steht "
"wieder auf {default}"

#: src/main.rs:296
msgid "Nothing to add"
msgstr "Nichts hinzuzufügen"

#: src/main.rs:297
msgid "Added {n}"
msgstr "{n} hinzugefügt"

#: src/main.rs:313
msgid "Added {n}; skipped {k} docling.rs does not read"
msgstr "{n} hinzugefügt; {k} übersprungen, die docling.rs nicht liest"

#: src/main.rs:318
msgid "Added {n}; skipped {k} docling.rs does not read ({extensions})"
msgstr ""
"{n} hinzugefügt; {k} übersprungen, die docling.rs nicht liest ({extensions})"

#: src/main.rs:386
msgid "Converting {count} to {format}"
msgstr "{count} werden zu {format} umgewandelt"

#: src/main.rs:390
msgid "{n} left queued until their folder is allowed, or choose Into a folder"
msgstr ""
"{n} bleiben in der Warteschlange, bis ihr Ordner freigegeben ist, oder "
"wählen Sie In einen Ordner"

#: src/main.rs:394
msgid ""
"Converting {count} to {format}; {n} left queued until their folder is "
"allowed, or choose Into a folder"
msgstr ""
"{count} werden zu {format} umgewandelt; {n} bleiben in der Warteschlange, "
"bis ihr Ordner freigegeben ist, oder wählen Sie In einen Ordner"

#: src/main.rs:434
msgid ""
"Allow Duckling to write beside the files in {folder}: choose that folder"
msgstr ""
"Duckling erlauben, neben den Dateien in {folder} zu schreiben: diesen Ordner "
"wählen"

#: src/main.rs:468 src/main.rs:660
msgid "Wrote {file}"
msgstr "{file} geschrieben"

#: src/main.rs:476
msgid "{file}: {reason}"
msgstr "{file}: {reason}"

#: src/main.rs:517
msgid "Add files…"
msgstr "Dateien hinzufügen …"

#: src/main.rs:520
msgid "Add folder…"
msgstr "Ordner hinzufügen …"

#: src/main.rs:524
msgid "Convert to"
msgstr "Umwandeln in"

#: src/main.rs:540
msgid ""
"Seconds rather than minutes on a PDF that already has text in it. No "
"headings, no tables, nothing from a scan."
msgstr ""
"Sekunden statt Minuten bei einem PDF, das bereits Text enthält. Keine "
"Überschriften, keine Tabellen, nichts aus einem Scan."

#: src/main.rs:541
msgid "Text layer only"
msgstr "Nur Textebene"

#: src/main.rs:545
msgid "Beside each file"
msgstr "Neben jede Datei"

#: src/main.rs:548
msgid "Into a folder"
msgstr "In einen Ordner"

#: src/main.rs:558
msgid "Choose another folder"
msgstr "Einen anderen Ordner wählen"

#: src/main.rs:570
msgid "Convert"
msgstr "Umwandeln"

#: src/main.rs:579
msgid "Clear finished"
msgstr "Fertige entfernen"

#: src/main.rs:598
msgid "Drop files or folders here, or use Add files."
msgstr "Dateien oder Ordner hierher ziehen, oder Dateien hinzufügen verwenden."

