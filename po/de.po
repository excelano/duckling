msgstr "{done} von {total} Seiten"

#: src/main.rs:666
msgid "Failed"
msgstr "Fehlgeschlagen"

#: src/main.rs:687
msgid "Select a file to see its result."
msgstr "Eine Datei auswählen, um ihr Ergebnis zu sehen."

#: src/main.rs:700
msgid "Queued. Press Convert."
msgstr "In der Warteschlange. Umwandeln drücken."

#: src/main.rs:705
msgid "Converting…"
msgstr "Wird umgewandelt …"

#: src/main.rs:722
msgid "Open"
msgstr "Öffnen"

#: src/main.rs:725
msgid "Could not open: {reason}"
msgstr "Konnte nicht geöffnet werden: {reason}"

#: src/main.rs:728
msgid "Show in folder"
msgstr "Im Ordner zeigen"

#: src/main.rs:731
msgid "Could not show: {reason}"
msgstr "Konnte nicht gezeigt werden: {reason}"

#: src/main.rs:736
msgid "Converted with parts skipped"
msgstr "Umgewandelt, Teile übersprungen"

#: src/main.rs:746
msgid "Preview shows the beginning; the file has the rest."
msgstr "Die Vorschau zeigt den Anfang; die Datei hat den Rest."

#: src/main.rs:790
msgid ""
"{queued} queued · {converting} converting · {done} done · {failed} failed"
msgstr ""
"{queued} in Warteschlange · {converting} werden umgewandelt · {done} fertig "
"· {failed} fehlgeschlagen"

