/target
/dist
/dist-*

# `make-ico` is its own package rather than part of this crate, so it has its
# own build directory and the rule above does not reach it. Its Cargo.lock is
# committed and its output - the `.ico`, `assets/` and `listing/` - is committed
# too, because nothing on Windows rasterizes an SVG.
/packaging/windows/make-ico/target

# Runtime assets: the ONNX models and pdfium, fetched by
# packaging/fetch-models.sh from pinned releases and shipped inside every
# package. Never committed; roughly 750 MB.
/.models
/.pdfium

# The prebuilt ONNX Runtime `ort` links, extracted here rather than into a
# user cache directory so that it and the build output naming it are one
# thing. `.github/workflows/windows.yml` says why that matters.
/.ort

/packaging/windows/identity.psd1
/packaging/windows/SUBMITTING.local.md
/packaging/windows/PASTE.local.md
/packaging/macos/SUBMITTING.local.md

# Duckling's own output, written when a checklist pass converts the demo
# folder. The sources beside it are committed; these are regenerated by
# running the application over them.
/packaging/demo/documents/*.dclg
